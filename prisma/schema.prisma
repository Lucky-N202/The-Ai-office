generator client {
  provider      = "prisma-client-js"
  // "native" covers your local machine (Windows/macOS/Linux glibc); "linux-musl-openssl-3.0.x"
  // is required for the node:*-alpine base image used in the Docker build below.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum PricingModel {
  FREE
  FREEMIUM
  PAID
  ENTERPRISE
  OPEN_SOURCE
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          Role       @default(USER)
  createdAt     DateTime   @default(now())
  bookmarks     Bookmark[]
  reviews       Review[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String // lucide-react icon name
  color       String // hex accent color
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tools       Tool[]
}

model Tool {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  tagline       String
  description   String       @db.Text
  websiteUrl    String
  // Optional secondary source to monitor (pricing/docs page) — the Intelligence
  // Engine watches both websiteUrl and docsUrl for changes when set.
  docsUrl       String?
  // Cursor for the discovery cron's round-robin batching — lets the job process
  // a bounded batch per run (serverless time limits) while still eventually
  // covering every tool, oldest-checked-first.
  lastCheckedAt DateTime?
  snapshots     ToolSnapshot[]
  changes       ToolChange[]
  // Optional affiliate/referral link. When set, outbound "Visit Website"
  // clicks route through it instead of websiteUrl (see /out/[id]). Leave null
  // until you're actually accepted into a tool's affiliate program.
  affiliateUrl  String?
  clickCount    Int          @default(0)
  logoUrl       String
  pricingModel  PricingModel @default(FREEMIUM)
  startingPrice Float?
  features      String[]
  pros          String[]
  cons          String[]
  tags          String[]
  rating        Float        @default(0)
  reviewCount   Int          @default(0)
  featured      Boolean      @default(false)
  verified      Boolean      @default(true)
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  bookmarks     Bookmark[]
  reviews       Review[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
  @@index([featured])
}

// Full, append-only history of fetched content per monitored source URL.
// Never deleted/overwritten — this is what makes it a genuine version history
// rather than just "current vs. one previous" state.
model ToolSnapshot {
  id          String   @id @default(cuid())
  toolId      String
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  sourceUrl   String
  contentHash String
  // Extracted, truncated readable text (not raw HTML) — kept short enough to
  // stay cheap to store and cheap to pass to the LLM for diffing.
  content     String   @db.Text
  fetchedAt   DateTime @default(now())

  @@index([toolId, sourceUrl, fetchedAt])
}

enum ChangeStatus {
  PENDING_REVIEW
  AUTO_APPLIED
  APPROVED
  REJECTED
}

// One row per AI-analyzed content change detected between two snapshots.
model ToolChange {
  id               String       @id @default(cuid())
  toolId           String
  tool             Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  sourceUrl        String
  fromSnapshotId   String?
  toSnapshotId     String
  summary          String       @db.Text
  changeType       String
  // 0–1, as reported by the LLM. Drives the auto-apply vs. needs-review split.
  confidence       Float
  // Partial Tool field updates the AI proposed (e.g. { "startingPrice": 25 }).
  // Applied verbatim on admin approval, or automatically above the confidence
  // threshold for low-risk change types — see src/lib/intelligence/analyze.ts.
  suggestedUpdates Json?
  status           ChangeStatus @default(PENDING_REVIEW)
  createdAt        DateTime     @default(now())
  reviewedAt       DateTime?

  @@index([toolId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String
  body      String   @db.Text
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([toolId, userId])
  @@index([toolId])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ToolSubmission {
  id             String           @id @default(cuid())
  name           String
  tagline        String
  description    String           @db.Text
  websiteUrl     String
  submitterEmail String
  status         SubmissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  reviewedAt     DateTime?

  @@index([status])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
}
